@@ -6,10 +6,17 @@
 #include <utility>
 
 #include "../io.hpp"
+#if defined(__ORBIS__)
+extern "C" const char* pswaker_gci_path(const char* path);
+#endif
 
 namespace aurora::card {
 
 FileIO::FileIO(const std::filesystem::path& filename, bool truncate) : m_path(filename) {
+#if defined(__ORBIS__)
+  // Only the game card worker's explicit save transaction redirects this file.
+  m_path = pswaker_gci_path(io::fs_path_to_string(filename).c_str());
+#endif
   if (m_path.empty()) {
     return;
   }

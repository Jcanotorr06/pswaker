+std::optional<ReplacementResult> find_replacement(const GXTexObj_& obj,
+    const std::optional<TextureSourceKey>& sourceKey) noexcept {
+  using namespace pswaker::replacement;
+  std::lock_guard lk(s_registryMutex);
+  const ReplacementKey pointerKey{TexturePointerKey{.data = obj.data}};
+  const auto source = sourceKey ? find_source_replacement_key_locked(*sourceKey) : std::nullopt;
+  const auto* pointerEntry = obj.data ? find_selected_entry_locked(pointerKey) : nullptr;
+  const auto* sourceEntry = source ? find_selected_entry_locked(*source) : nullptr;
+  const std::array candidates{
+      Candidate{pointerEntry ? pointerEntry->id : 0, KeyFamily::Pointer,
+                pointerEntry ? pointerEntry->priority : 0, pointerEntry ? pointerEntry->sequence : 0},
+      Candidate{sourceEntry ? sourceEntry->id : 0, KeyFamily::Source,
+                sourceEntry ? sourceEntry->priority : 0, sourceEntry ? sourceEntry->sequence : 0}};
+  const auto selected = select(candidates);
+  const auto load = [&](const ReplacementKey& key, const ReplacementEntry& entry) {
+    const bool alreadyFailed = s_failedIds.contains(entry.id);
+    auto result = find_replacement_for_key_locked(key);
+    if (result && entry.priority == promptPriority && !result->handle) {
+      result->suppressOriginal = true;
+      if (!alreadyFailed)
+        Log.warn("PROMPT unresolved surface=embedded-texture reason=prompt-upload-failed");
+    }
+    return result;
+  };
+  if (pointerEntry && selected == pointerEntry->id) return load(pointerKey, *pointerEntry);
+  if (sourceEntry && selected == sourceEntry->id) return load(*source, *sourceEntry);
+  return std::nullopt;
+}

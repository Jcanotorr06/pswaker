+static void dMeter_ps4Apply(void* picture, const void* texture) {
+    J2DPicture* pic = (J2DPicture*)picture;
+    pic->changeTexture((const ResTIMG*)texture, 0);
+}
+
+static void dMeter_ps4ButtonApply(void* picture, const void* texture) {
+    dMeter_ps4Apply(picture, texture);
+    J2DPicture* pic = (J2DPicture*)picture;
+    pic->setWhite(0xFFFFFFFF);
+    pic->setBlack(0x00000000);
+    pic->setCornerColor(0xFFFFFFFF);
+}
+
+// Resize once, before movement/scale routines capture the pane's dimensions.
+// The full PS4 tile needs room beyond the original 16-pixel GC letter overlay.
+static void dMeter_ps4Button(fopMsgM_pane_class* pane, PswakerHudControl control, f32 width, f32 height) {
+    f32 dx = (pane->mSizeOrig.x - width) * 0.5f;
+    f32 dy = (pane->mSizeOrig.y - height) * 0.5f;
+    pane->mPosTopLeftOrig.x += dx;
+    pane->mPosTopLeftOrig.y += dy;
+    pane->mPosTopLeft = pane->mPosTopLeftOrig;
+    pane->mSizeOrig.x = width;
+    pane->mSizeOrig.y = height;
+    pane->mSize = pane->mSizeOrig;
+    pane->pane->move(pane->mPosTopLeft.x, pane->mPosTopLeft.y);
+    pane->pane->resize(width, height);
+    pswaker_hud_picture_set(pane->pane, control, dMeter_ps4ButtonApply);
+}
+
+// Action descriptions are independent textures, not message icons. Keep the
+// game's context words/weapon art and pair them with their semantic control.
+static void dMeter_ps4Description(J2DPicture* picture, PswakerHudControl control, s16 status, const void* texture) {
+    switch (status) {
+    case dActStts_BLANK_e: case dActStts_LOOK_e: case dActStts_SPEAK_e: case dActStts_CHARTS_e:
+    case dActStts_LIFT_e: case dActStts_CLIMB_e: case dActStts_LET_GO_e: case dActStts_RETURN_e:
+    case dActStts_PUT_AWAY_e: case dActStts_DROP_e: case dActStts_CHECK_e: case dActStts_OPEN_e:
+    case dActStts_ATTACK_e: case dActStts_ba_osu: case dActStts_THROW_e: case dActStts_CROUCH_e:
+    case dActStts_SIDLE_e: case dActStts_GRAB_e: case dActStts_JUMP_e: case dActStts_STOP_e:
+    case dActStts_ba_haru: case dActStts_ba_tatamu: case dActStts_LET_GO_ROPE_e: case dActStts_CHOOSE_e:
+    case dActStts_ba_kogu: case dActStts_NEXT_e: case dActStts_PARRY_e: case dActStts_PICK_UP_e:
+    case dActStts_GET_IN_SHIP_e: case dActStts_GET_OUT_SHIP_e: case dActStts_ba_save: case dActStts_ba_option:
+    case dActStts_TAKE_PHOTO_e: case dActStts_INFO_e: case dActStts_SWAP_MODES_e: case dActStts_FLY_e:
+    case dActStts_CALL_e: case dActStts_BID_e: case dActStts_READ_e: case dActStts_CANCEL_e:
+    case dActStts_ba_kakudai: case dActStts_ba_hikaku: case dActStts_ba_zoom01: case dActStts_ba_zoom02:
+    case dActStts_CRUISE_e: case dActStts_ba_nageru__dupe_2D: case dActStts_ba_motu__dupe_2E: case dActStts_SWING_e:
+    case dActStts_SEA_CHART_e: case dActStts_ba_sake__dupe_31: case dActStts_ba_modoru__dupe_32: case dActStts_ba_save__dupe_33:
+    case dActStts_ba_save__dupe_34: case dActStts_sword_01: case dActStts_DEFEND_e: case dActStts_boko_stick:
+    case dActStts_hatchet: case dActStts_iron_club: case dActStts_longsword: case dActStts_spear:
+    case dActStts_spear__dupe_3C: case dActStts_bow_01: case dActStts_HIDDEN_e:
+        break;
+    default:

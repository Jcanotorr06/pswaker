+// Shows PS4 artwork (GX RGBA8 ResTIMG) in place of a GameCube control picture
+// without allocating: the game has already appended its own texture here.
+static void fopMsgM_ps4Apply(void* i_picture, void* i_shadow, const void* i_image, const void* i_partner) {
+    J2DPicture* pictures[] = {(J2DPicture*)i_picture, (J2DPicture*)i_shadow};
+    for (int i = 0; i < 2; i++) {
+        J2DPicture* pic = pictures[i];
+        if (pic == NULL) {
+            continue;
+        }
+        u8 last = 3;
+        while (last > 0 && pic->getTexture(last) == NULL) {
+            last--;
+        }
+        if (pic->getTexture(last) == NULL) {
+            continue;
+        }
+        pic->changeTexture((const ResTIMG*)i_image, last);
+        // Texture 0 is the crossfade partner of animated stick pictures.
+        if (i_partner != NULL && last > 0) {
+            pic->changeTexture((const ResTIMG*)i_partner, 0);
+        }
+    }
+    // Full-colour artwork is shown untinted; the shadow stays a black silhouette.
+    ((J2DPicture*)i_picture)->setWhite(0xFFFFFFFF);
+    ((J2DPicture*)i_picture)->setBlack(0x00000000);
+}
+
+// Clockwise quarter turns: the stick animations turn pictures by multiples of -90.
+static u8 fopMsgM_ps4Turns(J2DPicture* i_pic) {
+    f32 turns = -i_pic->getRotate() / 90.0f;
+    int rounded = (int)(turns < 0.0f ? turns - 0.5f : turns + 0.5f);
+    return (u8)(((rounded % 4) + 4) % 4);
+}
+
+// Control pictures become PS4 prompts for the applied controls and are retained
+// until destroyed, so Apply rebuilds an already-open message before resume.
+void fopMsgM_ps4Set(J2DPicture* i_iconPic, J2DPicture* i_sdwPic, u8 i_iconNo) {
+    pswaker_message_picture_set(i_iconPic, i_sdwPic, i_iconNo, fopMsgM_ps4Turns(i_iconPic), fopMsgM_ps4Apply);
+}
+
+// After the game turns a picture: keeps PS4 labels upright and tilts accurate.
+void fopMsgM_ps4Turned(J2DPicture* i_iconPic) {
+    pswaker_message_picture_turned(i_iconPic, fopMsgM_ps4Turns(i_iconPic));
+}
+#endif

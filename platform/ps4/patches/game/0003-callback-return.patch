+#if TARGET_PC
+// Some actors declare these methods as returning bool (one byte) and are called here as
+// returning int: on x86-64 the rest of the register is whatever was there, so TRUE can read as
+// something other than 1 and e.g. a delete is retried for ever (d_a_tag_attention's Mthd_Delete
+// at the end of A_mori's MEET_TETORA: the next scene never came). Only the low byte counts.
+#define PC_MTD_BOOL(x) ((x) & 0xFF)
+#else
+#define PC_MTD_BOOL(x) (x)
+#endif

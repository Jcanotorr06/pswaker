+#if defined(__ORBIS__)
+#include "JSystem/J2DGraph/J2DPicture.h"
+#include "pswaker/menu-pictures.h"
+
+static void dScnName_ps4Apply(void* picture, const void* texture) {
+    J2DPicture* pic = (J2DPicture*)picture;
+    pic->changeTexture((const ResTIMG*)texture, 0);
+    pic->setWhite(0xFFFFFFFF);
+    pic->setBlack(0x00000000);
+    pic->setCornerColor(0xFFFFFFFF);
+}
+
+// Resize around the same centre, before pane data captures the dimensions.
+// The full PS4 tile needs room beyond the original 16-pixel GC letter overlay;
+// a square slot keeps round buttons round. The Select/Back words stay native.
+static void dScnName_ps4Button(J2DScreen* screen, u32 tag, PswakerMenuControl control) {
+    J2DPane* pane = screen->search(tag);
+    // 0x12: J2DPicture. A layout without this picture has nothing to convert.
+    if (pane == NULL || pane->getTypeID() != 0x12) {
+        pswaker_menu_missing_picture(PswakerMenuFamily::FileSelect, tag);
+        return;
+    }
+    const f32 size = 32.0f;
+    f32 x = pane->getBounds().i.x - (size - pane->getWidth()) * 0.5f;
+    f32 y = pane->getBounds().i.y - (size - pane->getHeight()) * 0.5f;
+    pane->move(x, y);
+    pane->resize(size, size);
+    pswaker_menu_picture_set(pane, PswakerMenuFamily::FileSelect, control, dScnName_ps4Apply);
+}
+#endif

+
+// A drop shadow keeps the game's own tint: the same PS4 shape as a silhouette.
+static void dMenu_Fmap2_ps4ShadowApply(void* picture, const void* texture) {
+    ((J2DPicture*)picture)->changeTexture((const ResTIMG*)texture, 0);
+}
+
+static void dMenu_Fmap2_ps4Apply(void* picture, const void* texture) {
+    dMenu_Fmap2_ps4ShadowApply(picture, texture);
+    J2DPicture* pic = (J2DPicture*)picture;
+    pic->setWhite(0xFFFFFFFF);
+    pic->setBlack(0x00000000);
+    pic->setCornerColor(0xFFFFFFFF);
+}
+
+// Fixed L2/R2: the square 24-pixel slots already fit the PS4 tiles.
+static void dMenu_Fmap2_ps4Trigger(J2DScreen* screen, u32 tag, PswakerMenuControl control, PswakerMenuApply apply) {
+    J2DPane* pane = screen->search(tag);
+    // 0x12: J2DPicture. A layout without this picture has nothing to convert.
+    if (pane != NULL && pane->getTypeID() == 0x12) {
+        pswaker_menu_picture_set(pane, PswakerMenuFamily::SeaChart, control, apply);
+    } else {
+        pswaker_menu_missing_picture(PswakerMenuFamily::SeaChart, tag);
+    }
+}
+#endif
 
